{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Firm live decision response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "direction",
    "price_step",
    "expectation_bias",
    "confidence"
  ],
  "properties": {
    "direction": {
      "type": "string",
      "enum": ["raise", "hold", "cut"]
    },
    "price_step": {
      "type": "number",
      "minimum": -0.04,
      "maximum": 0.04
    },
    "expectation_bias": {
      "type": "number",
      "minimum": -0.04,
      "maximum": 0.04
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reasoning": {
      "type": "string",
      "description": "Natural language economic analysis (2-4 sentences)"
    },
    "why": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "description": "DEPRECATED: Use 'reasoning' field instead",
      "items": {
        "type": "string",
        "enum": [
          "baseline_guard",
          "demand_softening",
          "demand_spike",
          "cost_push",
          "credit_constraint",
          "inventory_pressure",
          "llm_uncertain"
        ]
      }
    },
    "comment": {
      "type": "string",
      "maxLength": 280,
      "description": "DEPRECATED: Use 'reasoning' field instead"
    }
  },
  "oneOf": [
    {"required": ["reasoning"]},
    {"required": ["why"]}
  ]
}
