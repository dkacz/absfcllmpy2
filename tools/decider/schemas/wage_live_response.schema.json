{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Wage live decision response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "direction",
    "wage_step",
    "confidence"
  ],
  "properties": {
    "direction": {
      "type": "string",
      "enum": ["raise", "hold", "cut"]
    },
    "wage_step": {
      "type": "number",
      "minimum": -0.04,
      "maximum": 0.04
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "labor_market_assessment": {
      "type": "string",
      "description": "Natural language labor market analysis (2-4 sentences)"
    },
    "why": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "description": "DEPRECATED: Use 'labor_market_assessment' field instead",
      "items": {
        "type": "string",
        "enum": [
          "baseline_guard",
          "labour_shortage",
          "unemployment_pressure",
          "inflation_pressure",
          "productivity_gap",
          "llm_uncertain"
        ]
      }
    },
    "comment": {
      "type": "string",
      "maxLength": 280,
      "description": "DEPRECATED: Use 'labor_market_assessment' field instead"
    }
  },
  "oneOf": [
    {"required": ["labor_market_assessment"]},
    {"required": ["why"]}
  ]
}
